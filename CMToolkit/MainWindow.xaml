<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="CMToolkit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}">

    <Grid RowDefinitions="Auto,*">
        <InfoBar
            x:Name="UpdateInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="False"
            Severity="Success"
            Title="An update is available:"
            Visibility="Collapsed" />

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="ShellNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview" />
                <NavigationViewItem Content="F4SE" Tag="F4SE" />
                <NavigationViewItem Content="Scanner" Tag="Scanner" />
                <NavigationViewItem Content="Tools" Tag="Tools" />
                <NavigationViewItem Content="Settings" Tag="Settings" />
                <NavigationViewItem Content="About" Tag="About" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
