<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="CmtColorGood">#00EE00</Color>
    <Color x:Key="CmtColorBad">#B22222</Color>
    <Color x:Key="CmtColorInfo">#1E90FF</Color>
    <Color x:Key="CmtColorWarning">#FFA500</Color>
    <Color x:Key="CmtColorNeutral">#808080</Color>

    <SolidColorBrush x:Key="CmtColorGoodBrush" Color="{StaticResource CmtColorGood}" />
    <SolidColorBrush x:Key="CmtColorBadBrush" Color="{StaticResource CmtColorBad}" />
    <SolidColorBrush x:Key="CmtColorInfoBrush" Color="{StaticResource CmtColorInfo}" />
    <SolidColorBrush x:Key="CmtColorWarningBrush" Color="{StaticResource CmtColorWarning}" />
    <SolidColorBrush x:Key="CmtColorNeutralBrush" Color="{StaticResource CmtColorNeutral}" />

    <FontFamily x:Key="CmtContentFontFamily">Cascadia Mono, Consolas, monospace</FontFamily>

    <x:Double x:Key="CmtFontSizeSmaller">10</x:Double>
    <x:Double x:Key="CmtFontSizeSmall">12</x:Double>
    <x:Double x:Key="CmtFontSizeNormal">14</x:Double>
    <x:Double x:Key="CmtFontSizeLarge">20</x:Double>

    <Style x:Key="CmtBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CmtFontSizeNormal}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
</ResourceDictionary>
